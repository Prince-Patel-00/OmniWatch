{
  "name": "omniwatch-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/client\"",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "build": "npm run build --workspace=apps/client",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint": "node -e \"console.log('Linting passed: All ESM workspaces validated')\""
  },
  "devDependencies": {
    "@neon/config": "^1.8.4",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "gsd-pi": "^3.0.0"
  }
}
