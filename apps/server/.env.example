# OmniWatch Server Environment Configuration

PORT=5000
NODE_ENV=development

# Optional: TMDB (The Movie Database) API Key
# Sign up for free at https://www.themoviedb.org/settings/api
# When provided, unlocks live TMDB Movie/TV exploration and JustWatch streaming availability
TMDB_API_KEY=

# Default Country for Streaming Availability (e.g. US, GB, IN, CA, JP, AU)
DEFAULT_STREAMING_REGION=US
