# ==============================================================================
# OmniWatch Environment Variables Template
# Copy this file to .env for local development or configure in Vercel Dashboard
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database Configuration (Neon Serverless PostgreSQL)
# Required for Vercel production deployments (Pooled connection recommended)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Optional local SQLite toggle (set to 1 to force local SQLite for offline dev)
# USE_SQLITE=1

# Authentication & Session Security
# Generate a secure 32+ character random string for production JWT tokens
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars

# External Metadata Providers
# TMDB (The Movie Database) API Key v3 - Required for Movie and TV series discovery
TMDB_API_KEY=your_tmdb_api_key_v3

# Default Regional Preference for Availability Mirrors
DEFAULT_STREAMING_REGION=US
